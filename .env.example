# Copy to .env and fill in. Never commit .env.
# data.gov.in OGD API key (account at https://www.data.gov.in/). Optional:
# without it the incremental path replays the archived dataset (labelled "replay").
AGRI_DATA_GOV_IN_API_KEY=
AGRI_DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Spark job paths (local defaults; use hdfs://localhost:9000/agri/... for the HDFS lake)
AGRI_SILVER_DAILY=data/processed/daily_market_prices
AGRI_FORECAST_ROOT=data/forecast
AGRI_GOLD_ROOT=data/gold
AGRI_RESULTS_ROOT=results/forecast
AGRI_MAX_TRAIN_ROWS=2000000

# API
AGRI_API_CORS_ORIGINS=http://localhost:8000
AGRI_API_RATE_PER_MIN=120
AGRI_APP_DIR=app

# Kafka
AGRI_KAFKA_BOOTSTRAP=localhost:9092

# Serving experiment (default fc_lgbm_2025; fc_main_v3 is the previous Spark model)
# AGRI_SERVING_MODEL=fc_lgbm_2025
