# ---------------------------------------------------------------
# Hadoop configuration, injected as environment variables.
#
# The apache/hadoop image turns CORE-SITE.XML_x / HDFS-SITE.XML_x
# variables into the corresponding *-site.xml properties, so the
# cluster is configured here rather than in mounted XML files.
# ---------------------------------------------------------------

# --- core-site.xml ---------------------------------------------
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:9000
# Staging dir for clients; kept inside the container's own tmp.
CORE-SITE.XML_hadoop.tmp.dir=/hadoop/tmp

# --- hdfs-site.xml ---------------------------------------------
HDFS-SITE.XML_dfs.namenode.name.dir=/hadoop/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=/hadoop/dfs/data

# Replication 3 across 3 DataNodes. This is the setting the viva
# question "what is replication?" refers to: each 128 MB block is
# stored on three different DataNodes, so one can be lost without
# data loss or read interruption.
HDFS-SITE.XML_dfs.replication=3

# 128 MB block size (Hadoop's default, stated explicitly because the
# project needs to reason about block counts). A 6.5 GB file becomes
# ~52 blocks, which is what makes the read parallelisable — Spark
# gets one task per block by default.
HDFS-SITE.XML_dfs.blocksize=134217728

# Bind the NameNode's RPC and HTTP endpoints on all interfaces so the
# host (and Spark running on the host) can reach them.
HDFS-SITE.XML_dfs.namenode.rpc-bind-host=0.0.0.0
HDFS-SITE.XML_dfs.namenode.servicerpc-bind-host=0.0.0.0
HDFS-SITE.XML_dfs.namenode.http-bind-host=0.0.0.0

# Spark runs on the HOST, outside this Docker network, so it cannot
# resolve the container hostnames the NameNode hands back. Telling
# clients to use hostnames (not container-internal IPs) lets the host
# reach DataNodes via the published ports.
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true
HDFS-SITE.XML_dfs.datanode.use.datanode.hostname=true

# Permission checking off: this is a single-user academic cluster and
# the host user (kaush) does not exist inside the containers.
HDFS-SITE.XML_dfs.permissions.enabled=false
