# ---------------------------------------------------------------
# Data is NEVER committed. The raw datasets alone are ~12 GB and the
# scaled workload takes it to ~18 GB.
# ---------------------------------------------------------------
data/raw/
data/processed/
data/scaled/
data/sample/*
!data/sample/.gitkeep

# Spark / Hadoop local runtime artefacts
spark-warehouse/
metastore_db/
derby.log
checkpoints/
*.crc
_SUCCESS

# sbt / Scala build output
target/
project/target/
project/project/
.bsp/

# Results are regenerated by running the pipeline. Small summary
# files are committed explicitly with `git add -f`.
results/**/_temporary/

# macOS
.DS_Store

# Editors
.idea/
.vscode/
*.iml

results/synthesis_profile/
data/validate_engineered/
data/features/
.metals/
.scala-build/
data/
