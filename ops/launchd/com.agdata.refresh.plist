<?xml version="1.0" encoding="UTF-8"?>
<!-- Daily AG-DATA refresh at 07:30 local time (macOS launchd). NOT installed automatically.
     Install:   cp ops/launchd/com.agdata.refresh.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.agdata.refresh.plist
     Remove:    launchctl unload ~/Library/LaunchAgents/com.agdata.refresh.plist && rm ~/Library/LaunchAgents/com.agdata.refresh.plist
     Edit the two paths below if the repository lives elsewhere. The API key is read from .env by scripts/refresh.sh. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agdata.refresh</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Users/kaush/Downloads/Agricultural_BigData_Project/scripts/refresh.sh</string></array>
  <key>WorkingDirectory</key><string>/Users/kaush/Downloads/Agricultural_BigData_Project</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/Users/kaush/Downloads/Agricultural_BigData_Project/logs/refresh_launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/kaush/Downloads/Agricultural_BigData_Project/logs/refresh_launchd.log</string>
  <key>EnvironmentVariables</key><dict><key>AGRI_ALERT_MACOS</key><string>1</string></dict>
</dict>
</plist>
